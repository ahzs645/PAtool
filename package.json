{
  "name": "patool",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/geo-toolkit",
    "shared",
    "app",
    "worker"
  ],
  "scripts": {
    "predev": "npm run toolkit:build",
    "dev": "concurrently -n app,worker -c blue,green \"npm run dev --workspace app\" \"npm run dev --workspace worker\"",
    "dev:app": "npm run dev --workspace app",
    "dev:worker": "npm run dev --workspace worker",
    "toolkit:build": "npm run build --workspace @pgmaps/geo-toolkit",
    "toolkit:watch": "npm run watch --workspace @pgmaps/geo-toolkit",
    "build": "npm run build --workspaces --if-present",
    "build:pages": "npm run toolkit:build && npm run equations:extract && npm run prepare:static-data && npm run build --workspace app",
    "equations:extract": "node scripts/extract_equations.mjs",
    "fixtures:convert": "python3.13 scripts/convert_rda_fixtures.py",
    "fixtures:import-bitesizedaq": "node scripts/import_bitesizedaq_data.mjs",
    "network:build": "node scripts/build_network_timeseries.mjs data/prince-george-sample shared/src/generated/network_timeseries.sample.json day",
    "prepare:static-data": "node scripts/prepare_static_data.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:heatmap-browser": "node scripts/check_heatmap_flicker.mjs",
    "test:responsive": "node scripts/check_responsive_layout.mjs",
    "test:interactive": "node scripts/check_interactive_layout.mjs",
    "typecheck": "npm run toolkit:build && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright": "^1.59.1"
  }
}
